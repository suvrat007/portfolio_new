# Copy to .env.local for local overrides. All are optional.

# Where the browser sends API requests. Defaults to the relative "/api",
# which Vercel rewrites in production and Vite proxies in development.
# VITE_API_BASE_URL=/api

# Where Vite's dev proxy forwards "/api". Point this at a local backend to
# develop against it: http://localhost:8000
# VITE_API_PROXY_TARGET=https://project-api-y3d4.onrender.com

# Where `npm run snapshot` reads the build-time payload from.
# SNAPSHOT_API_URL=https://project-api-y3d4.onrender.com/api/content
