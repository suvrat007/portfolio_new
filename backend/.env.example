# Copy to .env and fill in. Never commit the real file.
NODE_ENV=development
PORT=8000

# MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Long random string used to sign admin JWTs.
ACCESS_TOKEN_SECRET=

# Optional comma separated allowlist. Leave empty to reflect any origin.
CORS_ORIGINS=
